# Αντίγραψε ως .env (δεν γίνεται commit). Εναλλακτικά όλα ρυθμίζονται από Ρυθμίσεις στην εφαρμογή
# (αποθηκεύονται κρυπτογραφημένα). Προτεραιότητα: Ρυθμίσεις εφαρμογής > .env.
GROQ_API_KEY=
OPENROUTER_API_KEY=
BUSINESS_PORTAL_KEY=
# Λογαριασμός TAXISnet του γραφείου (για ανάκτηση ΔΟΥ/καθεστώτος ΦΠΑ/κατηγορίας βιβλίων)
AADE_USER=
AADE_PASS=
# Προαιρετικό: άλλος φάκελος δεδομένων (default: %LOCALAPPDATA%\TaxMatch)
# TAXMATCH_DATA_DIR=
